<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RaceDay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project is part of the solution but must not be compiled into the Web API project. -->
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Tests/**/obj/**/*.cs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.21" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
</Project>
